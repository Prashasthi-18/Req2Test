# Demo mode streams prepared outputs and needs no API key.
# Leave MOCK_MODE unset to auto-select: demo without GROQ_API_KEY, live with it.
MOCK_MODE=true

# Live mode (MOCK_MODE=false): free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=groq/llama-3.3-70b-versatile

# Optional: enables "Import from Jira" (Jira Cloud, API token auth)
JIRA_BASE_URL=https://atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
